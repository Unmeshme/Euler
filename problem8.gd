#problem 8 looks really annoying
#

#key thoughts
# a 1000 length number can't be represented by 'int'
# we can store it in a string or even better an array and then just multiply each 13 digit products


extends SceneTree

var Number: String = ""


func _init():
    var start = Time.get_unix_time_from_system()
    var solution = main(Number)

    var duration = Time.get_unix_time_from_system() - start

    print("Solution: %s, Duration: %.5f " %[solution, duration])

    quit()


func main(p_num: String)->int:
    return find_the_greatest(p_num)


func find_the_greatest(p_num: String) -> int:
    var m_greatest_product: int = 1
    for i in range(0, p_num.length() - 13 + 1):
        var m_temp: int = 1
        for j in range (0, 13):
            m_temp *= (ord(p_num[i+j]) - ord('0'))
        if m_greatest_product < m_temp:
            m_greatest_product = m_temp
    
    return m_greatest_product



